<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="New payment"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:text="History"
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter amount"
            android:textColor="#777777"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="QAR 0.00"
            android:textColor="#111111"
            android:textSize="36sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D32F2F"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRetry"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry"
                android:textColor="#D32F2F"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <TableRow android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn1"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="1"
                android:textColor="#222222"
                android:textSize="20sp" />
            <Button
                android:id="@+id/btn2"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="2"
                android:textColor="#222222"
                android:textSize="20sp" />
            <Button
                android:id="@+id/btn3"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="3"
                android:textColor="#222222"
                android:textSize="20sp" />
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn4"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="4"
                android:textColor="#222222"
                android:textSize="20sp" />
            <Button
                android:id="@+id/btn5"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="5"
                android:textColor="#222222"
                android:textSize="20sp" />
            <Button
                android:id="@+id/btn6"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="6"
                android:textColor="#222222"
                android:textSize="20sp" />
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn7"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="7"
                android:textColor="#222222"
                android:textSize="20sp" />
            <Button
                android:id="@+id/btn8"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="8"
                android:textColor="#222222"
                android:textSize="20sp" />
            <Button
                android:id="@+id/btn9"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="9"
                android:textColor="#222222"
                android:textSize="20sp" />
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnCancel"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_cancel"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
            <Button
                android:id="@+id/btn0"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_num"
                android:text="0"
                android:textColor="#222222"
                android:textSize="20sp" />
            <Button
                android:id="@+id/btnOK"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_ok"
                android:enabled="false"
                android:text="OK"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </TableRow>
    </TableLayout>

</LinearLayout>